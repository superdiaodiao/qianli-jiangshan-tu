<view class="stage">
  <!-- 触摸事件绑在容器上：卷首题签、释文卡都浮在画布之上，
       绑在 canvas 上会被浮层挡住，第一次拖动就没反应 -->
  <view class="viewport"
    bindtouchstart="onTouchStart" bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd">
    <canvas type="2d" id="stage" class="cv"></canvas>
    <!-- 时刻画卡的合成画布：常驻屏外，仅存图时使用 -->
    <canvas type="2d" id="cardCv" class="cardCv"></canvas>

    <view class="bar" style="width:{{barPct}}%;opacity:{{barPct>=100?0:1}}"></view>

    <!-- 悬浮按钮：返回键与胶囊同排，音/存在胶囊正下方；位置由 onLoad 按胶囊实测写入。
         动作挂 touchend（同元素 catch 会吞 tap），tap 兜底，JS 里防抖 -->
    <view class="backBtn serif" style="top:{{uiTop}}px" catchtouchstart="noop" catchtouchmove="noop"
      catchtouchend="goBack" catchtap="goBack">⟨ 画廊</view>
    <!-- 图标下带两字标签：不认识图标的人也知道这俩是干啥的 -->
    <view class="fabs" style="top:{{fabTop}}px">
      <view class="fabCol">
        <view class="fab ico-sound {{soundOn?'on':''}}" catchtouchstart="noop" catchtouchmove="noop"
          catchtouchend="onSoundTap" catchtap="onSoundTap"></view>
        <view class="fabTag serif">聆音</view>
      </view>
      <view class="fabCol">
        <view class="fab ico-save" catchtouchstart="noop" catchtouchmove="noop"
          catchtouchend="onSnapTap" catchtap="onSnapTap"></view>
        <view class="fabTag serif">存图</view>
      </view>
    </view>

    <!-- 竖轴：右侧竖向缩略图，框出当前视窗，点/拖跳转（横卷的缩略图在控制台里） -->
    <view class="vmap" wx:if="{{vertical}}" style="top:{{fabTop + 62}}px;width:{{vmapW}}px;height:{{vmapH}}px"
      catchtouchstart="onVMapTouch" catchtouchmove="onVMapTouch" catchtouchend="noop">
      <image class="vmapImg" src="{{thumb}}" mode="scaleToFill"/>
      <view class="vmapBox" style="top:{{mapLeft}}%;height:{{mapWidth}}%"></view>
    </view>

    <view class="intro {{introGone?'gone':''}}" wx:if="{{introShow}}" bindtap="hideIntro">
      <view class="introBox">
        <view class="openBtn serif" catchtap="onOpen">展 卷</view>
        <view class="vmeta serif">{{meta}}</view>
        <view class="vtitle serif">{{title}}<view class="seal serif">{{artist}}</view></view>
      </view>
    </view>

<!-- 玩法卡片：每幅画第一次展卷后弹出（控制台「玩法」可再开）；点任意处关闭，随后画上圈出可点之处 -->
    <view class="guideMask" wx:if="{{guideShow}}" catchtouchstart="noop" catchtouchmove="noop"
      catchtouchend="onGuideOk" catchtap="onGuideOk">
      <view class="guideBox">
        <view class="guideTitle serif">怎 么 看</view>
        <view class="guideRow serif"><text class="gIcon">拖</text>{{vertical ? '上下拖动展卷' : '左右拖动展卷'}}，双指缩放</view>
        <view class="guideRow serif" wx:for="{{guideTaps}}" wx:key="index"><text class="gIcon">点</text>{{item}}</view>
        <view class="guideRow serif"><text class="gIcon">释</text>点画上的朱点，看释文</view>
        <view class="guideRow serif"><text class="gIcon">存</text>右上角存「此刻画卡」，可落款分享</view>
        <view class="guideNote" wx:if="{{hintNote}}">{{hintNote}}</view>
        <view class="guideBtn serif">知 道 了</view>
      </view>
    </view>

    <view class="card {{cardOn?'on':''}}" catchtouchstart="noop"
      catchtouchmove="noop" catchtouchend="noop">
      <!-- 父容器 catch 触摸后子元素 tap 不再合成，关闭逻辑挂自己的 touchend 上 -->
      <view class="close" catchtouchend="onCloseCard" catchtap="onCloseCard">×</view>
      <view class="cardT serif">{{cardT}}</view>
      <view class="cardD">{{cardD}}</view>
    </view>
  </view>

  <view class="console" wx:if="{{!panelHidden}}">
    <scroll-view class="guide" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="guideLabel serif">导览</view>
      <view class="chip serif {{activePoi===index?'on':''}}" wx:for="{{pois}}" wx:key="index"
        data-i="{{index}}" bindtap="onChip">{{item.t}}</view>
    </scroll-view>
    <!-- 横卷缩略图独占一行、通栏：长卷 23:1，塞在半行里只能拉糊 -->
    <view class="mapRow" wx:if="{{!vertical}}">
      <view class="mapWrap" bindtouchstart="onMapTouch" bindtouchmove="onMapTouch">
        <image class="mapImg" src="{{thumb}}" mode="scaleToFill"/>
        <view class="mapBox" style="left:{{mapLeft}}%;width:{{mapWidth}}%"></view>
        <view class="mapTick {{index%2?'b':''}}" wx:for="{{pois}}" wx:key="index"
          style="left:{{item.u/au*100}}%"></view>
      </view>
    </view>
    <view class="cRow">
      <view class="todBlock">
        <view class="todName serif">{{todName}}</view>
        <view class="todWrap">
          <slider class="rng" min="0" max="1000" value="{{todVal}}" block-size="14"
            activeColor="#2c3844" backgroundColor="#2c3844" block-color="#bb4032"
            bindchanging="onTod" bindchange="onTod"/>
          <view class="scale serif"><text>晓</text><text>午</text><text>暮</text><text>夜</text></view>
        </view>
      </view>
    </view>
    <view class="cRow2">
      <view class="btns">
        <view class="btn serif {{autoOn?'on':''}}" bindtap="onAuto">时辰自转</view>
        <view class="btn serif {{tourOn?'on':''}}" bindtap="onTour">巡游</view>
        <view class="btn serif {{zoomOn?'on':''}}" bindtap="onZoom">{{zoomLabel}}</view>
        <view class="btn serif {{bellOn?'on':''}}" wx:if="{{hasBell}}" bindtap="onBellTap">钟声</view>
        <view class="btn serif" bindtap="onGuide">玩法</view>
      </view>
      <view class="segBlock">
        <text class="segLabel serif">天候</text>
        <view class="seg">
          <view class="segBtn serif {{mode===0?'on':''}}" data-m="0" bindtap="onMode">晴</view>
          <view class="segBtn serif {{mode===1?'on':''}}" wx:if="{{!noRain}}" data-m="1" bindtap="onMode">雨</view>
          <view class="segBtn serif {{mode===2?'on':''}}" data-m="2" bindtap="onMode">雪</view>
        </view>
      </view>
    </view>
    <view class="cRow3">
      <view class="wetName serif">{{wetName}}</view>
      <view class="wetWrap">
        <slider class="rng" min="0" max="1000" value="{{wetVal}}" block-size="14"
          activeColor="#2c3844" backgroundColor="#2c3844" block-color="#bb4032"
          bindchanging="onWet" bindchange="onWet"/>
        <view class="scale serif"><text>无</text><text>微</text><text>盛</text><text>骤</text></view>
      </view>
    </view>
  </view>
  <view class="panelToggle serif" bindtap="onPanel">{{panelHidden?'展开':'收起'}}</view>

  <!-- 时刻画卡预览浮层：所见即所得，可落款、发朋友、存相册 -->
  <view class="cardMask" wx:if="{{cardShow}}" catchtouchmove="noop">
    <view class="cardPop">
      <view class="cardX" catchtap="onCardClose">×</view>
      <image class="cardPrev" src="{{cardImg}}" mode="widthFix" show-menu-by-longpress/>
      <view class="signRow">
        <text class="signLabel serif">落款</text>
        <input class="signInput serif" type="nickname" value="{{signName}}"
          placeholder="点此署名（可用微信昵称）" placeholder-class="signPh"
          bindblur="onSignChange" bindconfirm="onSignChange"/>
      </view>
      <view class="cardBtns">
        <view class="cardBtn primary serif" catchtap="onCardShare">发给朋友</view>
        <view class="cardBtn serif" catchtap="onCardSave">存入相册</view>
      </view>
      <view class="cardRaw serif" catchtap="onCardRaw">只存画面，不要卡片</view>
    </view>
  </view>
</view>
