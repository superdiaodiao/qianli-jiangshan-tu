.hall { min-height: 100vh; padding: calc(env(safe-area-inset-top, 20px) + 60rpx) 36rpx 60rpx; box-sizing: border-box; }

.head { text-align: center; margin-bottom: 64rpx; }
.appTitle { font-size: 64rpx; font-weight: 500; letter-spacing: .3em; color: var(--paper); }
.appSub { margin-top: 18rpx; font-size: 22rpx; letter-spacing: .3em; color: var(--paper-3); }

.list { display: flex; flex-direction: column; gap: 36rpx; }

.pcard { display: flex; border: 1rpx solid var(--line-soft); background: var(--ink-800); overflow: hidden; }
.pcard.soon { opacity: .68; }

.pthumb { position: relative; width: 300rpx; height: 240rpx; flex-shrink: 0; background: #1a222c; }
.pimg { width: 100%; height: 100%; }
.pblank { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%;
  font-size: 84rpx; color: rgba(201,169,105,.28); }
.pveil { position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(11,15,19,0) 60%, rgba(18,24,32,.92)); }
.psoon { position: absolute; right: 12rpx; top: 12rpx; font-size: 19rpx; letter-spacing: .18em;
  color: #e8cfc2; background: rgba(187,64,50,.85); padding: 6rpx 12rpx; }

.pmeta { flex: 1; padding: 26rpx 28rpx; min-width: 0; }
.ptitle { font-size: 36rpx; font-weight: 500; letter-spacing: .12em; color: var(--paper); }
.partist { margin-top: 8rpx; font-size: 22rpx; letter-spacing: .12em; color: var(--silk); }
.pline { margin-top: 14rpx; font-size: 22rpx; line-height: 1.7; color: var(--paper-2); }
.ptags { margin-top: 14rpx; display: flex; gap: 10rpx; }
.ptag { font-size: 19rpx; letter-spacing: .1em; color: var(--paper-3); border: 1rpx solid var(--line); padding: 4rpx 12rpx; }

.foot { margin-top: 72rpx; text-align: center; font-size: 20rpx; letter-spacing: .2em; color: var(--paper-3); }
